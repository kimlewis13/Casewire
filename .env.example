# Copy this file to .env.local before running the app.

# Anthropic (Claude API) — required. Powers the client intake conversation;
# without it, the chatbot's opening message still shows but every reply
# after that fails. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Everything below is optional — without it, the status tracker still
# detects and flags overdue cases, it just skips the actual send and says so.

# Resend (email) — https://resend.com
RESEND_API_KEY=
RESEND_FROM_EMAIL="Casewire Alerts <alerts@yourdomain.com>"
ALERT_EMAIL_TO=you@example.com

# textbee (SMS via your own Android phone as gateway) — https://textbee.dev
# Set this up before building the tracker screen — it's the one step that
# can stall the build if left for later.
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
ALERT_PHONE_TO=+15555550100
